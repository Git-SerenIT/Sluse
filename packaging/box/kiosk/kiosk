#
# Headless sway with the console in it (D-025). No screen of its own; wayvnc
# shows it. From S-8 1b's 1b-vnc-kiosk.sh.
set -eu
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
# The console's Firefox profile, from a box made before 0.3: the console is
# Sluse's own program now (D-079), and its home disk keeps the old profile.
rm -rf "$HOME/snap/firefox/common/sluse-kiosk"
# Claude Desktop keeps its sign-in only in a keyring (D-045 point 6). A login
# keyring with no password is a plain file that gnome-keyring opens unlocked,
# on D-Bus activation, with no prompt: the sign-in sits unencrypted on the
# home disk, as Claude Code's ~/.claude does. Made once; one already there is
# left alone.
keyrings="$HOME/.local/share/keyrings"
if [ ! -e "$keyrings/login.keyring" ]; then
  mkdir -p "$keyrings" && chmod 700 "$keyrings"
  printf '[keyring]\ndisplay-name=login\nctime=0\nmtime=0\nlock-on-idle=false\nlock-after=false\n' > "$keyrings/login.keyring"
  printf login > "$keyrings/default"
fi
# sway does not name itself; the portal reads the name to pick its backends
# (sway's sway-portals.conf). See sway.conf. foot finds the theme's colours
# (theme, Q70) first among the system's configs, after the person's own.
exec env WLR_BACKENDS=headless WLR_LIBINPUT_NO_DEVICES=1 XDG_CURRENT_DESKTOP=sway \
    XDG_CONFIG_DIRS="$XDG_RUNTIME_DIR/sluse/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}" \
    sway -c /usr/local/lib/sluse/sway.conf

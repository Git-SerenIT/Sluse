[Unit]
Description=Sluse: VNC from the host only
Before=sluse-vnc.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /usr/local/lib/sluse/vnc.nft
ExecStop=/usr/sbin/nft delete table inet sluse_vnc

[Install]
WantedBy=multi-user.target

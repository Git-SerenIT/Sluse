# A command-line runtime in the console's terminal (D-027 point 3), through a
# login shell so ~/.local/bin, where the vendors install, is on the path.
# A header first, as docs/design/mockups/desktop/box.html draws it: on the
# first run the sign-in route that works in the box, after that one line.
# Microsoft's sign-in cannot open in the box (D-044), so the route is the
# address copied out, or typed when copying out is off (Q64, from the
# config's clipboard setting, which sluse-bootstrap keeps). When the runtime
# stops with an error the window stays until Enter, so its message can be
# read: Claude Code's "Unable to connect" closed with its terminal before
# anyone saw it (L1, 2026-10-05).
case "$1" in
    claude) name="Claude Code" ;;
    codex) name="Codex" ;;
    vibe) name="Mistral Vibe" ;;
    *) echo "cli: $1 is not one of the box's runtimes" >&2; exit 2 ;;
esac
# In the workspace, so the work and what is fetched sit where the inventory
# looks; a default, not a fence: the runtime can write the rest of home
# (L1, 2026-10-07). Home before the first open has made the workspace.
# Codex and Vibe are left out of a base built with their bundle off
# (user-data.yaml, D-070): say so, not "command not found".
if ! bash -lc "command -v $1" >/dev/null 2>&1; then
    printf '%s is not installed in this box. Send the details to your IT department.\nPress Enter to close this window. ' "$name"
    read -r _
    exit 127
fi
# Vibe reads its user config only, so Sluse writes it here, at launch, and
# again whenever what Sluse would write changes (a new revision's models);
# otherwise the user's own edits stay. Mistral's EU endpoint for a key; a
# signed-in account uses the global one (D-070, amended). The models are the
# deployment's, from /etc/sluse/vibe.toml (written at enrolment): what Vibe
# offers, not a limit, since this file is the user's. Without them Vibe has
# its one built-in model. Telemetry, updates and Mistral's hosted connectors
# off: their hosts are not listed, and each refusal would be an Event Log
# record (D-070).
if [ "$1" = vibe ]; then
    want=$(cat <<TOML
enable_telemetry = false
enable_update_checks = false
enable_auto_update = false
enable_connectors = false
$(cat /etc/sluse/vibe.toml 2>/dev/null)

[[providers]]
name = "mistral"
api_base = "https://api.eu.mistral.ai/v1"
api_key_env_var = "MISTRAL_API_KEY"
browser_auth_base_url = "https://console.mistral.ai"
browser_auth_api_base_url = "https://console.mistral.ai/api"
backend = "mistral"

[[mcp_servers]]
name = "sluse"
transport = "stdio"
command = "/usr/local/bin/sluse-endpoint"
args = ["--config", "$HOME/Sluse/sluse.json", "--mcp"]
TOML
)
    sum=$(printf '%s\n' "$want" | sha256sum | cut -d' ' -f1)
    stamp="$HOME/.vibe/.sluse-written"
    if [ "$(cat "$stamp" 2>/dev/null)" != "$sum" ]; then
        mkdir -p "$HOME/.vibe" && printf '%s\n' "$want" > "$HOME/.vibe/config.toml" && printf '%s\n' "$sum" > "$stamp"
    fi
fi
if cd "$HOME/Sluse/workspace" 2>/dev/null; then folder="~/Sluse/workspace"; else cd "$HOME"; folder="~"; fi
seen="${XDG_CONFIG_HOME:-$HOME/.config}/sluse/$1-seen"
dim=$(printf '\033[2m') bold=$(printf '\033[1m') off=$(printf '\033[0m')
rule="${dim}────────────────────────────────────────────────────────────${off}"
if [ -e "$seen" ]; then
    printf '%s%s, in %s%s\n%s\n\n' "$dim" "$name" "$folder" "$off" "$rule"
else
    if [ "$1" = codex ]; then
        how="When Codex asks you to sign in, choose Sign in with ChatGPT and finish in
the browser that opens. Signed in to the ChatGPT app in this box, Codex is
too. If the page does not load, choose the device code instead and enter it
in your browser on Windows."
    elif [ "$1" = vibe ]; then
        # Vibe's browser sign-in polls Mistral from the box (D-070): the
        # address is opened elsewhere and nothing is pasted back.
        if [ "$(cat /run/sluse/copy-out 2>/dev/null)" = off ]; then
            how="When Mistral Vibe asks you to sign in, choose the browser and finish in the
one that opens. If the page does not load, type the address it shows into
your browser on Windows and sign in there; Vibe carries on by itself."
        else
            how="When Mistral Vibe asks you to sign in, choose the browser and finish in the
one that opens. If the page does not load, open the address it shows in your
browser on Windows and sign in there; Vibe carries on by itself."
        fi
    elif [ "$(cat /run/sluse/copy-out 2>/dev/null)" = off ]; then
        how="When Claude Code asks you to sign in, finish in the browser that opens. If
the page does not load, type the address it shows into your browser on
Windows, and paste the code you get back here."
    else
        how="When Claude Code asks you to sign in, finish in the browser that opens. If
the page does not load, copy the address it shows, open it in your browser on
Windows, and paste the code you get back here."
    fi
    printf '%s%s, in your box.%s\n%sWorking folder  %s\n\nSign in once, with your organisation'\''s account. Your box keeps it.\n%s%s\n%s\n\n' \
        "$bold" "$name" "$off" "$dim" "$folder" "$how" "$off" "$rule"
    mkdir -p "$(dirname "$seen")" && : > "$seen"
fi
bash -lc "$1"
s=$?
[ "$s" -eq 0 ] && exit 0
printf '\n%s stopped (exit %s). Press Enter to close this window. Open it again from the Sluse console. ' "$name" "$s"
read -r _
exit "$s"

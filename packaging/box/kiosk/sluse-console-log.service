[Unit]
Description=Sluse: the box's log to the host's administrators, over the serial console
After=systemd-journald.service

[Service]
ExecStart=/usr/local/libexec/sluse/console-log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

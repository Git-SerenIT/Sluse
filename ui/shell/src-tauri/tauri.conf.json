{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sluse",
  "version": "0.0.1",
  "identifier": "dk.serenit.sluse",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Sluse",
        "width": 1600,
        "height": 932,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://*:7583; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/256x256.png", "icons/icon.ico"]
  }
}
